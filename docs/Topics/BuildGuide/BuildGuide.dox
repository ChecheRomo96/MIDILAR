/**
 * @defgroup MIDILAR_BuildGuide Build Guide
 * @brief Configure MIDILAR against a matching Foundation package.
 *
 * MIDILAR locates or fetches Foundation automatically (see
 * @ref MIDILAR_BuildGuide_Dependency):
 *
 * @code{.bash}
 * ./scripts/configure.sh macos_arm64 --fresh
 * ./scripts/build.sh macos_arm64 --config Debug
 * @endcode
 *
 * To use a specific Foundation package, point MIDILAR at its prefix:
 *
 * @code{.bash}
 * ./scripts/configure.sh macos_arm64 --fresh -- \
 *   -DMIDILAR_FOUNDATION_PREFIX=../Foundation/dist/macos_arm64
 * @endcode
 */
